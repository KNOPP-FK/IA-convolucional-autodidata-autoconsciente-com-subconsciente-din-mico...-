# Parâmetros do sistema de integração dinâmica
T_inicial = 5.0  # Tensão inicial
M_inicial = 1.0  # Memória sinestésica inicial
T_local_inicial = 0.5  # Tensão local inicial
y0 = [T_inicial, M_inicial, T_local_inicial]

# Intervalo de tempo para o modelo dinâmico
t = np.linspace(0, 50, 1000)

# Resolver o sistema de equações diferenciais
result = odeint(sistema, y0, t, args=(alpha, beta, gamma, 0.05, 10, 0.1, n1))

# Extração dos resultados
T, M, T_local = result.T

# Plotar os resultados do sistema dinâmico
plt.figure(figsize=(10, 6))
plt.plot(t, T, label='Tensão (T)')
plt.plot(t, M, label='Memória Sinestésica (M)')
plt.plot(t, T_local, label='Tensão Local (T_local)')
plt.axhline(10, color='r', linestyle='--', label='Tensão Crítica')
plt.xlabel('Tempo')
plt.ylabel('Valores')
plt.title('Dinâmica de Tensão e Memória Sinestésica com Equilíbrio Dinâmico')
